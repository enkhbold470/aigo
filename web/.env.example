# OpenAI-compatible gateway credentials.
# BASE_URL may be a bare host, a /v1 root, or a full /v1/chat/completions URL;
# the app normalizes it to the /v1 root the OpenAI SDK expects.
OPENAI_API_KEY=ark_live_...
BASE_URL=https://rizz.arkor.app/v1

# Optional. Defaults to google/gemini-3-5-flash-lite.
AI_MODEL=google/gemini-3-5-flash-lite
# Optional. Model used for screenshot/vision requests; defaults to AI_MODEL.
AI_VISION_MODEL=google/gemini-3-5-flash-lite
